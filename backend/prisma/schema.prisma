generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  username      String?         @unique
  password      String?
  name          String?
  avatar        String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  
  profile       Profile?
  applications  Application[]
  collabMembers CollabMember[]
  collabRequests CollabRequest[] @relation("CreatedRequests")
}

model Profile {
  id           String   @id @default(uuid())
  userId       String   @unique
  bio          String?
  portfolio    String?
  linkedinUrl  String?
  githubUrl    String?
  location     String?
  currentRole  String?  // 'student' | 'employee' | 'founder'
  organization String?  // College if student, Company if employee/founder
  
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills       Skill[]
}

model Job {
  id           String        @id @default(uuid())
  title        String
  organization String?
  description  String
  location     String?
  compensation String?
  type         String        @default("Full-Time")
  status       String        @default("open")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  
  requirements Skill[]
  applications Application[]
}

model Application {
  id         String   @id @default(uuid())
  jobId      String
  userId     String
  status     String   @default("pending")
  resumeLink String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CollabRequest {
  id             String   @id @default(uuid())
  creatorId      String
  title          String
  description    String
  category       String?
  coverImage     String?
  projectType    String?  @default("Side Project")
  duration       String?  @default("Unspecified")
  status         String   @default("open")
  openRoles      String?
  isClosed       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  requiredSkills Skill[]
  creator        CollabMember[]
  owner          User @relation("CreatedRequests", fields: [creatorId], references: [id], onDelete: Cascade)
}

model CollabMember {
  id              String   @id @default(uuid())
  collabRequestId String
  userId          String
  role            String?
  message         String?
  portfolioLink   String?
  status          String   @default("pending") // pending, accepted, rejected, withdrawn
  rejectionReason String?
  joinedAt        DateTime @default(now())
  
  request CollabRequest @relation(fields: [collabRequestId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Skill {
  id             String          @id @default(uuid())
  name           String          @unique
  
  profiles       Profile[]
  jobs           Job[]
  collabRequests CollabRequest[]
}
